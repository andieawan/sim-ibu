# ============================================================================
# SIM-IBU Environment Configuration Example
# ============================================================================

# ---- Gemini AI API ----
# Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---- Application Base URL ----
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Database Configuration ----
# DB_TYPE: 'sqlite' (default), 'postgres', or 'mysql'
# Anda dapat memilih salah satu dari 3 mode di bawah ini tanpa mengubah kode sumber:
#
#   ========================================================================
#   [MODE A] SQLite Lokal (Default, Sangat cocok untuk VPS kecil/demo/dev)
#   ========================================================================
#   DB_TYPE=sqlite
#   (Tidak membutuhkan server database terpisah, data disimpan di server/data/sekolah.db)
#
#   ========================================================================
#   [MODE B] MySQL (Lokal di VPS, Server terpisah, atau Container Docker)
#   ========================================================================
#   DB_TYPE=mysql
#   DB_HOST=localhost            # Isi 'localhost' untuk VPS polos, atau 'db' jika menggunakan Docker Compose
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=your_secure_mysql_password
#   DB_NAME=sigup_db
#
#   ========================================================================
#   [MODE C] PostgreSQL (Lokal di VPS, Server terpisah, atau Container Docker)
#   ========================================================================
#   DB_TYPE=postgres
#   DB_HOST=localhost            # Isi 'localhost' untuk VPS polos, atau 'db' jika menggunakan Docker Compose
#   DB_PORT=5432
#   DB_USER=postgres
#   DB_PASSWORD=your_secure_postgres_password
#   DB_NAME=sigup_db
#   DB_SSL=false                 # Set true jika server PostgreSQL membutuhkan SSL/TLS
#   ========================================================================

DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=sigup_db
DB_SSL=false

# ---- Default Credentials for Database Seeding ----
# Kredensial default yang otomatis dibuat saat pertama kali database diinisialisasi
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_GURU_PASSWORD=guru123
DEFAULT_ORTU_PASSWORD=ortu123

# ---- Cookie Authentication Secret ----
# Harus diisi dengan string acak panjang minimal 32 karakter untuk enkripsi session cookie
COOKIE_PASSWORD="a_very_long_and_secure_random_string_of_at_least_32_characters"

# ---- Application Mode ----
# APP_ENV: 'dev' atau 'pub'
# - 'dev' (Development Mode): Menampilkan opsi akun demo cepat di halaman login untuk kemudahan uji coba.
# - 'pub' (Production/Publish Mode): Menyembunyikan tombol demo, menghapus seluruh data rekayasa saat restart,
#                                    dan hanya menyisakan akun 'admin' utama secara default untuk siap input data baru rill.
APP_ENV=dev
